# 复制为 .env 后按需修改：cp .env.example .env
# .env 含 PSK，已在 .gitignore 中忽略，请勿提交。

SNELL_VERSION=6.0.0
SNELL_IMAGE=snell-server

# 容器内运行 snell 的用户，需能读取 ./config/snell-server.conf
PUID=1000
PGID=1000

# trace | verbose | notify | warning
SNELL_LOG_LEVEL=notify

# 设置后每次启动先下载这个 snell-server（官方 zip 或裸二进制）再运行，
# 下载/校验/试运行失败时回退到镜像自带版本。{arch} 会替换为 amd64 / aarch64 / i386。
# 例：https://dl.nssurge.com/snell/snell-server-v6.0.0-linux-{arch}.zip
SNELL_BIN_URL=
# 可选但强烈建议：下载文件的 sha256（对应当前机器架构的那个包）
SNELL_BIN_SHA256=

# ---- 以下仅在 ./config/snell-server.conf 不存在时用于生成配置 ----
# 留空则自动生成 32 位随机 PSK（写入配置文件，不打印到日志）
# 只允许字母、数字和 ._~+/=@:,!%^*()-，长度 12-255
SNELL_PSK=
SNELL_PORT=7177
# 设置后覆盖 SNELL_PORT，例如 0.0.0.0:7177,[::]:7177
SNELL_LISTEN=
# default（加密+混淆）| unshaped（仅加密）| unsafe-raw（明文，仅限可信网络）
SNELL_MODE=default
# 逗号分隔的 DNS 服务器 IP，留空使用容器默认 DNS
SNELL_DNS=
# default | prefer-ipv4 | prefer-ipv6 | ipv4-only | ipv6-only
SNELL_DNS_IP_PREFERENCE=default
# 出站绑定网卡名，通常配合 network_mode: host 使用
SNELL_EGRESS_INTERFACE=
